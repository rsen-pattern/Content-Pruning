# Copy to .streamlit/secrets.toml (gitignored) or set the matching env var.
# The sidebar shows which source the active key came from (input / secrets / env).
# Either name works; BIFROST_API_KEY is preferred, BIFROST_KEY is the legacy name.

BIFROST_API_KEY = "your-bifrost-key-here"
# BIFROST_KEY = "your-bifrost-key-here"
